{% macro header(this, kwargs) %}
<title>{{ this.title|e }}</title>
<meta name="description" content="Interaktive Karte: Arbeitgeber für Machine Learning, Materialwissenschaft und Energiewende im Umkreis von {{ this.radius_km }} km um {{ this.region_name }}.">
<meta name="theme-color" content="#1f3b73">
<style>
  :root { --jm-ink: #1d2433; --jm-muted: #5b6475; --jm-line: #d9dde5; --jm-accent: #1f3b73; --jm-soft: #eef2f8; }
  html, body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }

  /* Panel: links oben; unten rechts bleibt Platz für Zoom und Standort */
  .jm-panel { position: absolute; top: 10px; left: 10px; z-index: 1000; width: 350px;
    max-height: calc(100% - 20px); display: flex; flex-direction: column; box-sizing: border-box;
    background: #fff; color: var(--jm-ink); border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,.25);
    font-size: 14px; line-height: 1.35; }
  @media (max-width: 700px) {
    .jm-panel { right: 10px; width: auto; max-height: calc(100% - 150px); font-size: 15px; }
  }
  .jm-head { display: flex; align-items: center; gap: 8px; padding: 10px 12px; cursor: pointer; flex: none;
    border: 0; background: none; width: 100%; text-align: left; font: inherit; color: inherit; }
  .jm-head h1 { font-size: 15px; margin: 0; flex: 1; }
  .jm-head small { display: block; font-weight: normal; color: var(--jm-muted); font-size: 12px; }
  .jm-toggle { font-size: 18px; color: var(--jm-muted); transition: transform .15s; }
  .jm-panel.jm-collapsed .jm-toggle { transform: rotate(-90deg); }
  .jm-panel.jm-collapsed .jm-body { display: none; }
  .jm-body { padding: 0 12px 12px; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
  .jm-body input[type=search], .jm-body select { width: 100%; box-sizing: border-box; font: inherit;
    font-size: 16px; padding: 8px 10px; border: 1px solid var(--jm-line); border-radius: 8px; background: #fff; }
  .jm-count { margin: 8px 0 4px; color: var(--jm-muted); font-size: 13px; }

  .jm-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .jm-chip { position: relative; display: inline-flex; align-items: center; gap: 4px; padding: 5px 10px;
    border: 1px solid var(--jm-line); border-radius: 16px; font-size: 13px; cursor: pointer; user-select: none;
    background: #fff; }
  .jm-chip small { color: var(--jm-muted); }
  .jm-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .jm-chip.jm-on { background: var(--jm-accent); border-color: var(--jm-accent); color: #fff; }
  .jm-chip.jm-on small { color: #d6def0; }
  .jm-chip:focus-within { outline: 2px solid var(--jm-accent); outline-offset: 1px; }
  .jm-layers .jm-chip:not(.jm-on) { text-decoration: line-through; color: var(--jm-muted); }
  .jm-chip.jm-zero:not(.jm-on) { opacity: .45; }
  .jm-mode { display: inline-flex; gap: 10px; font-size: 12px; }
  .jm-mode label { display: inline-flex; align-items: center; gap: 3px; cursor: pointer; }
  .jm-note { color: #8a5a00; font-size: 12px; margin: 2px 0 4px; }
  .jm-note:empty { display: none; }
  .jm-actions { position: sticky; bottom: 0; background: #fff; padding: 8px 0 0; margin-top: 8px;
    border-top: 1px solid var(--jm-line); }
  .jm-primary { width: 100%; font: inherit; font-weight: 600; padding: 10px 12px; border-radius: 8px; border: 0;
    background: var(--jm-accent); color: #fff; cursor: pointer; }
  .jm-primary:disabled { background: #9aa3b5; cursor: default; }

  .jm-sec { margin-top: 10px; border-top: 1px solid var(--jm-line); }
  .jm-sec > summary { cursor: pointer; padding: 9px 0 6px; font-weight: 600; list-style-position: inside; }
  .jm-pill { display: inline-block; min-width: 18px; padding: 0 6px; border-radius: 9px; background: var(--jm-accent);
    color: #fff; font-size: 12px; text-align: center; margin-left: 4px; }
  .jm-pill:empty { display: none; }
  .jm-field { margin: 8px 0 10px; border: 0; padding: 0; }
  .jm-field > legend, .jm-field > .jm-label { display: flex; justify-content: space-between; align-items: center;
    width: 100%; padding: 0; margin-bottom: 6px; font-size: 13px; color: var(--jm-muted); }
  .jm-field input[type=range] { width: 100%; min-height: 28px; margin: 0; }
  .jm-check { display: flex; align-items: center; gap: 8px; min-height: 30px; }
  .jm-reset { margin-top: 4px; font: inherit; font-size: 13px; padding: 6px 12px; border-radius: 8px;
    border: 1px solid var(--jm-line); background: var(--jm-soft); color: var(--jm-ink); cursor: pointer; }

  .jm-results { list-style: none; margin: 0; padding: 0; }
  .jm-results li { display: flex; align-items: center; gap: 8px; padding: 8px 2px; min-height: 28px;
    border-bottom: 1px solid var(--jm-line); cursor: pointer; }
  .jm-results li:hover { background: #f4f6fa; }
  .jm-results .jm-kind { color: var(--jm-muted); font-size: 12px; margin-left: auto; white-space: nowrap; }
  .jm-gradient { height: 10px; border-radius: 5px; margin: 4px 0 2px; }
  .jm-legend-scale { display: flex; justify-content: space-between; }
  .jm-small { font-size: 12px; color: var(--jm-muted); }
  .jm-small a { color: var(--jm-accent); }

  .jm-badge { display: inline-block; min-width: 22px; padding: 1px 6px; border-radius: 10px; text-align: center;
    font-weight: 600; font-size: 12px; }
  .jm-new { display: inline-block; padding: 0 6px; border-radius: 8px; background: #ffe08a; color: #5a4500;
    font-size: 11px; font-weight: 600; margin-left: 4px; }
  .jm-pop { font-size: 13px; line-height: 1.4; color: var(--jm-ink); }
  .jm-pop h3 { font-size: 15px; margin: 0 0 4px; }
  .jm-pop .jm-reason { margin: 6px 0; }
  .jm-pop .jm-sub { color: var(--jm-muted); font-size: 12px; }
  .jm-pop ul { margin: 4px 0 6px; padding-left: 18px; }
  .jm-pop li { margin-bottom: 4px; }
  .jm-pop a { color: var(--jm-accent); }
  .leaflet-popup-content { margin: 12px 14px; max-height: 55vh; overflow-y: auto; }
  @media (max-width: 700px) { .leaflet-popup-content { max-height: 45vh; } }

  .jm-cluster div { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 12px; background: #fff; color: var(--jm-ink); border: 3px solid;
    box-shadow: 0 1px 5px rgba(0,0,0,.4); }
  .jm-cluster-job div { border-radius: 8px; }
  .jm-cluster-company div { border-radius: 50%; }
</style>
<script>
  var JM_COLORS = {{ this.colors|tojson }};
  var JM_TEXT = {{ this.text_colors|tojson }};
  function jmClusterIcon(kind) {
    return function (cluster) {
      var best = 0;
      cluster.getAllChildMarkers().forEach(function (m) { best = Math.max(best, m.options.score || 0); });
      return L.divIcon({
        html: '<div style="border-color:' + JM_COLORS[best] + '">' + cluster.getChildCount() + '</div>',
        className: 'jm-cluster jm-cluster-' + kind,
        iconSize: L.point(34, 34)
      });
    };
  }
</script>
{% endmacro %}

{% macro chips(name, items) %}
<div class="jm-chips" data-group="{{ name }}">
  {% for label, count in items %}
  <label class="jm-chip"><input type="checkbox" value="{{ label|e }}">{{ label|e }} <small>{{ count }}</small></label>
  {% endfor %}
</div>
{% endmacro %}

{% macro html(this, kwargs) %}
<div class="jm-panel" id="jm-panel">
  <button class="jm-head" id="jm-head" type="button" aria-expanded="true" aria-controls="jm-body">
    <h1>{{ this.heading|e }}<small>Stand: {{ this.updated }}</small></h1>
    <span class="jm-toggle" aria-hidden="true">▾</span>
  </button>
  <div class="jm-body" id="jm-body">
    <input type="search" id="jm-q" placeholder="Firma oder Stichwort, z. B. Batterie" autocomplete="off"
           aria-label="Firma oder Stichwort suchen">
    <div class="jm-count" id="jm-count" aria-live="polite"></div>
    <div class="jm-note" id="jm-note"></div>
    <div class="jm-chips jm-layers" role="group" aria-label="Ebenen">
      <label class="jm-chip jm-on"><input type="checkbox" id="jm-layer-job" checked>Offene Stellen</label>
      <label class="jm-chip jm-on"><input type="checkbox" id="jm-layer-company" checked>Firmen ohne Ausschreibung</label>
    </div>

    <details class="jm-sec" id="jm-filters">
      <summary>Filter<span class="jm-pill" id="jm-active"></span></summary>
      <div class="jm-field">
        <label class="jm-label" for="jm-min">Mindest-Priorität <span class="jm-badge" id="jm-min-val">0/10</span></label>
        <input type="range" id="jm-min" min="0" max="10" step="1" value="0">
      </div>
      <div class="jm-field">
        <label class="jm-label" for="jm-dist">Max. Entfernung von {{ this.region_name }} <b id="jm-dist-val"></b></label>
        <input type="range" id="jm-dist" min="5" max="{{ this.radius_km }}" step="5" value="{{ this.radius_km }}">
      </div>
      <fieldset class="jm-field">
        <legend>Branche
          <span class="jm-mode" role="radiogroup" aria-label="Verknüpfung der Branchen">
            <label title="Nur Einträge, die zu allen gewählten Branchen passen"><input type="radio" name="jm-catmode" value="all" checked>alle</label>
            <label title="Einträge, die zu mindestens einer gewählten Branche passen"><input type="radio" name="jm-catmode" value="any">mind. eine</label>
          </span>
        </legend>
        {{ chips('cats', this.categories) }}
      </fieldset>
      <fieldset class="jm-field">
        <legend>Anstellungsart <span>nur Stellen</span></legend>
        {{ chips('types', this.job_types) }}
      </fieldset>
      <fieldset class="jm-field">
        <legend>Arbeitszeit <span>nur Stellen</span></legend>
        {{ chips('hours', this.hours) }}
        <label class="jm-check"><input type="checkbox" id="jm-ho"> Homeoffice möglich
          <small class="jm-small">({{ this.homeoffice_count }})</small></label>
      </fieldset>
      <div class="jm-field">
        <label class="jm-label" for="jm-age">Veröffentlicht <span>nur Stellen</span></label>
        <select id="jm-age">
          <option value="0">beliebig</option>
          <option value="7">in den letzten 7 Tagen</option>
          <option value="14">in den letzten 14 Tagen</option>
          <option value="30">in den letzten 30 Tagen</option>
        </select>
      </div>
      <label class="jm-check"><input type="checkbox" id="jm-new"> nur neue Einträge (seit der letzten Woche)</label>
      <button type="button" class="jm-reset" id="jm-reset">Filter zurücksetzen</button>
      <p class="jm-small">Die Zahlen an den Feldern zeigen, wie viele Einträge (Stellen und Firmen) mit dieser
        Auswahl übrig blieben. Filter mit „nur Stellen“ blenden Firmen ohne Ausschreibung aus.</p>
    </details>

    <details class="jm-sec" id="jm-list-sec">
      <summary>Trefferliste<span class="jm-pill" id="jm-list-n"></span></summary>
      <ul class="jm-results" id="jm-results"></ul>
    </details>

    <details class="jm-sec">
      <summary>Legende &amp; Quellen</summary>
      <div class="jm-small">
        Farbe und Zahl im Marker = Priorität (Relevanz-Score 0–10)
        <div class="jm-gradient" style="background: linear-gradient(to right, {{ this.colors|join(', ') }});"></div>
        <div class="jm-legend-scale"><span>0 passt kaum</span><span>10 passt sehr gut</span></div>
        <p>Tropfen = offene Stellen · Kreis = Firma ohne passende Ausschreibung · weiße Gruppen mit farbigem
          Rand = mehrere Einträge (Zahl = Anzahl, Randfarbe = beste Priorität).</p>
        <p>{{ this.stats }}</p>
        <p>Stellen: Jobsuche der Bundesagentur für Arbeit · Firmen: © OpenStreetMap-Mitwirkende (ODbL),
          Wikidata (CC0), eigene Liste · Bewertung: {{ this.scoring_note }}.</p>
        <a href="{{ this.repo_url }}" target="_blank" rel="noopener">Quellcode &amp; Daten</a> ·
        <a href="data/companies.json" target="_blank" rel="noopener">Firmen (JSON)</a> ·
        <a href="data/jobs.json" target="_blank" rel="noopener">Stellen (JSON)</a>
      </div>
    </details>
    <div class="jm-actions"><button type="button" class="jm-primary" id="jm-show">Treffer auf Karte zeigen</button></div>
  </div>
</div>
{% endmacro %}

{% macro script(this, kwargs) %}
(function () {
  var map = {{ this._parent.get_name() }};
  var RADIUS = {{ this.radius_km }};
  var NARROW = 700;
  var groups = [
    { kind: 'job', cluster: {{ this.jobs_cluster }}, toggle: 'jm-layer-job', markers: [] },
    { kind: 'company', cluster: {{ this.companies_cluster }}, toggle: 'jm-layer-company', markers: [] }
  ];
  groups.forEach(function (g) { g.markers = g.cluster.getLayers(); });

  var $ = function (id) { return document.getElementById(id); };
  var panel = $('jm-panel'), head = $('jm-head'), results = $('jm-results'), listSec = $('jm-list-sec');
  L.DomEvent.disableClickPropagation(panel);
  L.DomEvent.disableScrollPropagation(panel);

  function narrow() { return window.innerWidth <= NARROW; }
  function setCollapsed(collapsed) {
    panel.classList.toggle('jm-collapsed', collapsed);
    head.setAttribute('aria-expanded', String(!collapsed));
  }
  head.addEventListener('click', function () { setCollapsed(!panel.classList.contains('jm-collapsed')); });
  if (narrow()) { setCollapsed(true); } else { $('jm-filters').open = true; }

  // Popups so verschieben, dass sie nicht unter dem Panel landen
  function popupPadding() {
    L.Popup.prototype.options.autoPanPaddingTopLeft =
      narrow() ? L.point(10, panel.offsetHeight + 20) : L.point(panel.offsetWidth + 30, 10);
  }
  popupPadding();
  window.addEventListener('resize', popupPadding);

  // Auf Touch-Geräten bleiben Tooltips nach dem Antippen stehen und verdecken die Karte
  if (window.matchMedia('(hover: none)').matches) {
    groups.forEach(function (g) { g.markers.forEach(function (m) { m.unbindTooltip(); }); });
  }

  function checked(group) {
    var set = new Set();
    panel.querySelectorAll('[data-group="' + group + '"] input:checked').forEach(function (i) { set.add(i.value); });
    return set;
  }
  function readState() {
    return {
      terms: $('jm-q').value.toLowerCase().split(/\s+/).filter(Boolean),
      min: parseInt($('jm-min').value, 10),
      dist: parseInt($('jm-dist').value, 10),
      cats: checked('cats'), catMode: panel.querySelector('input[name=jm-catmode]:checked').value,
      types: checked('types'), hours: checked('hours'),
      ho: $('jm-ho').checked, age: parseInt($('jm-age').value, 10), onlyNew: $('jm-new').checked,
      layers: { job: $('jm-layer-job').checked, company: $('jm-layer-company').checked }
    };
  }
  var state = readState();

  // Filter, die sich nur auf Stellen beziehen: Firmen ohne Ausschreibung können sie nie erfüllen
  function jobFiltersActive(s) { return s.types.size || s.hours.size || s.ho || s.age > 0; }
  function catsOk(cats, s) {
    if (!s.cats.size) return true;
    var sel = Array.from(s.cats);
    return s.catMode === 'all' ? sel.every(function (c) { return cats.indexOf(c) !== -1; })
                               : sel.some(function (c) { return cats.indexOf(c) !== -1; });
  }
  function termsOk(text, s) { return s.terms.every(function (t) { return text.indexOf(t) !== -1; }); }

  // Jede Stelle wird einzeln geprüft, jede Firma ohne Ausschreibung als ein Eintrag
  function jobOk(o, j, s) {
    if (!s.layers.job || o.score < s.min) return false;
    if (!termsOk(o.search + ' ' + j.s, s) || !catsOk(j.c, s)) return false;
    if (s.types.size && !s.types.has(j.t)) return false;
    if (s.hours.size && !j.h.some(function (h) { return s.hours.has(h); })) return false;
    if (s.ho && !j.ho) return false;
    if (s.age && (j.age === null || j.age > s.age)) return false;
    if ((j.d !== null ? j.d : o.dist) > s.dist) return false;
    if (s.onlyNew && !j.n) return false;
    return true;
  }
  function companyOk(o, s) {
    if (!s.layers.company || jobFiltersActive(s) || o.score < s.min) return false;
    if (!termsOk(o.search, s) || !catsOk(o.cats, s)) return false;
    if (o.dist !== null && o.dist > s.dist) return false;
    if (s.onlyNew && !o.isnew) return false;
    return true;
  }
  // Anzahl passender Einträge eines Markers
  function matches(m, kind, s) {
    var o = m.options;
    if (kind === 'job') return o.jobs.filter(function (j) { return jobOk(o, j, s); }).length;
    return companyOk(o, s) ? 1 : 0;
  }
  function total(s) {
    var n = 0;
    groups.forEach(function (g) { g.markers.forEach(function (m) { n += matches(m, g.kind, s); }); });
    return n;
  }

  // Zahl an jedem Filterfeld: so viele Einträge blieben übrig, wenn man es (zusätzlich) wählt
  function updateFacetCounts() {
    ['cats', 'types', 'hours'].forEach(function (group) {
      panel.querySelectorAll('[data-group="' + group + '"] input').forEach(function (input) {
        var trial = Object.assign({}, state);
        var set = (group === 'cats' && state.catMode === 'all') ? new Set(state[group]) : new Set();
        set.add(input.value);
        trial[group] = set;
        var n = total(trial);
        input.parentNode.querySelector('small').textContent = n;
        input.parentNode.classList.toggle('jm-zero', n === 0);
      });
    });
  }

  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  var visibleMarkers = [];
  function apply() {
    state = readState();
    $('jm-min-val').textContent = state.min + '/10';
    $('jm-min-val').style.background = JM_COLORS[state.min];
    $('jm-min-val').style.color = JM_TEXT[state.min];
    $('jm-dist-val').textContent = state.dist + ' km';
    var active = (state.min > 0) + (state.dist < RADIUS) + state.cats.size + state.types.size +
      state.hours.size + state.ho + (state.age > 0) + state.onlyNew;
    $('jm-active').textContent = active || '';
    panel.querySelectorAll('.jm-chip input').forEach(function (i) {
      i.parentNode.classList.toggle('jm-on', i.checked);
    });

    var hits = [], counts = { job: 0, company: 0 };
    visibleMarkers = [];
    groups.forEach(function (g) {
      var on = state.layers[g.kind], visible = [];
      g.markers.forEach(function (m) {
        var n = matches(m, g.kind, state);
        if (n > 0) { visible.push(m); hits.push({ marker: m, group: g, n: n }); counts[g.kind] += n; }
      });
      g.cluster.clearLayers();
      g.cluster.addLayers(visible);
      visibleMarkers = visibleMarkers.concat(visible);
      if (on && !map.hasLayer(g.cluster)) map.addLayer(g.cluster);
      if (!on && map.hasLayer(g.cluster)) map.removeLayer(g.cluster);
    });
    $('jm-count').textContent = 'Sichtbar: ' + counts.job + ' Stellen · ' + counts.company +
      ' Firmen ohne Ausschreibung';
    $('jm-note').textContent = state.layers.company && jobFiltersActive(state)
      ? 'Firmen ohne Ausschreibung sind ausgeblendet, weil ein Stellen-Filter aktiv ist.' : '';
    var nHits = counts.job + counts.company;
    $('jm-show').textContent = nHits ? nHits + ' Treffer auf Karte zeigen' : 'Keine Treffer';
    $('jm-show').disabled = !nHits;
    updateFacetCounts();

    hits.sort(function (a, b) { return b.marker.options.score - a.marker.options.score; });
    $('jm-list-n').textContent = hits.length;
    results.innerHTML = '';
    hits.slice(0, 150).forEach(function (h) {
      var o = h.marker.options;
      var li = document.createElement('li');
      li.innerHTML = '<span class="jm-badge" style="background:' + JM_COLORS[o.score] + ';color:' +
        JM_TEXT[o.score] + '">' + o.score + '</span><span>' + esc(o.label) + '</span>' +
        '<span class="jm-kind">' + (h.group.kind === 'job' ? h.n + (h.n === 1 ? ' Stelle' : ' Stellen') : 'Firma') +
        '</span>';
      li.addEventListener('click', function () {
        if (narrow()) setCollapsed(true);
        // Popups sind "lazy": der Inhalt wird erst beim ersten Klick gesetzt, daher Klick auslösen
        h.group.cluster.zoomToShowLayer(h.marker, function () {
          if (!h.marker.isPopupOpen()) h.marker.fire('click');
        });
      });
      results.appendChild(li);
    });
    if (state.terms.length) listSec.open = true;
  }

  // Panel zuklappen (Handy) und auf alle sichtbaren Treffer zoomen
  $('jm-show').addEventListener('click', function () {
    if (!visibleMarkers.length) return;
    if (narrow()) setCollapsed(true);
    var bounds = L.latLngBounds(visibleMarkers.map(function (m) { return m.getLatLng(); }));
    map.fitBounds(bounds, {
      paddingTopLeft: narrow() ? L.point(30, panel.offsetHeight + 30) : L.point(panel.offsetWidth + 40, 30),
      paddingBottomRight: L.point(60, 30), maxZoom: 14
    });
  });

  // Im Popup nur die Stellen zeigen, die zu den Filtern passen
  map.on('popupopen', function (e) {
    if (narrow()) setCollapsed(true);
    var marker = e.popup._source, root = e.popup.getElement();
    if (!marker || !marker.options.jobs || !root) return;
    var hidden = 0;
    root.querySelectorAll('li[data-job]').forEach(function (li) {
      var ok = jobOk(marker.options, marker.options.jobs[+li.getAttribute('data-job')], state);
      li.style.display = ok ? '' : 'none';
      hidden += ok ? 0 : 1;
    });
    var note = root.querySelector('.jm-hidden-note');
    if (note) note.textContent = hidden ? hidden + ' weitere durch Filter ausgeblendet' : '';
    e.popup.update();
  });

  var timer;
  $('jm-q').addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(apply, 150); });
  panel.querySelectorAll('input[type=range]').forEach(function (i) { i.addEventListener('input', apply); });
  panel.querySelectorAll('input[type=checkbox], input[type=radio], select').forEach(function (i) {
    i.addEventListener('change', apply);
  });
  $('jm-reset').addEventListener('click', function () {
    $('jm-min').value = 0; $('jm-dist').value = RADIUS; $('jm-age').value = 0;
    panel.querySelectorAll('#jm-filters input[type=checkbox]').forEach(function (i) { i.checked = false; });
    apply();
  });
  apply();
})();
{% endmacro %}
